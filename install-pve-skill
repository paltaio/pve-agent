#!/usr/bin/env bash
# Installs the pve-agent skill for the agent CLIs found on this machine.
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/paltaio/pve-agent/main/install-pve-skill | bash
#
# Run inside a checkout it installs that checkout; run anywhere else it clones
# the repository. Missing credentials are asked for on the terminal; without
# one, PVE_HOST and a credential pair are required in the environment.
# A CLI counts as installed when its binary is on PATH or its config directory
# exists. PVE_SKILL_TARGETS=claude,codex,/some/skills picks the targets by name
# or skills directory; PVE_SKILL_LIST=1 prints the targets and exits.
set -euo pipefail

repo_url="https://github.com/paltaio/pve-agent.git"
repo_ref="${PVE_SKILL_REF:-main}"
skill_name="pve-agent"
work_dir=""
staging=""
previous=""
target=""

skill_roots=(
	"claude|claude|$HOME/.claude|$HOME/.claude/skills"
	"codex|codex|$HOME/.codex|$HOME/.agents/skills"
	"opencode|opencode|$HOME/.config/opencode|$HOME/.agents/skills"
	"gemini|gemini|$HOME/.gemini|$HOME/.agents/skills"
	"cursor|agent|$HOME/.cursor|$HOME/.agents/skills"
	"copilot|copilot|$HOME/.copilot|$HOME/.agents/skills"
	"amp|amp|$HOME/.config/amp|$HOME/.agents/skills"
	"goose|goose|$HOME/.config/goose|$HOME/.agents/skills"
	"droid|droid|$HOME/.factory|$HOME/.agents/skills"
)

roots=()
root_names=()
add_root() {
	local root="$1" name="$2" i
	for i in "${!roots[@]}"; do
		if [[ "${roots[$i]}" == "$root" ]]; then
			root_names[i]="${root_names[$i]}, $name"
			return
		fi
	done
	roots+=("$root")
	root_names+=("$name")
}

root_for_name() {
	local row name binary config root
	for row in "${skill_roots[@]}"; do
		IFS='|' read -r name binary config root <<<"$row"
		if [[ "$name" == "$1" ]]; then
			printf '%s' "$root"
			return 0
		fi
	done
	return 1
}

if [[ -n "${PVE_SKILL_TARGETS:-}" ]]; then
	IFS=',' read -r -a wanted <<<"$PVE_SKILL_TARGETS"
	for item in "${wanted[@]}"; do
		item="${item#"${item%%[! ]*}"}"
		item="${item%"${item##*[! ]}"}"
		if [[ -z "$item" ]]; then
			continue
		fi
		if [[ "$item" == */* ]]; then
			add_root "${item/#\~/$HOME}" "path"
		elif root="$(root_for_name "$item")"; then
			add_root "$root" "$item"
		else
			echo "unknown target $item; names: claude codex opencode gemini cursor copilot amp goose droid" >&2
			exit 1
		fi
	done
else
	for row in "${skill_roots[@]}"; do
		IFS='|' read -r name binary config root <<<"$row"
		if command -v "$binary" >/dev/null 2>&1 || [[ -d "$config" ]]; then
			add_root "$root" "$name"
		fi
	done
fi

if [[ ${#roots[@]} -eq 0 ]]; then
	echo "no agent CLI found; supported targets, detected by binary on PATH or config directory:" >&2
	for row in "${skill_roots[@]}"; do
		IFS='|' read -r name binary config root <<<"$row"
		echo "  $name: $binary, ${config/#"$HOME"/\~} -> ${root/#"$HOME"/\~}" >&2
	done
	echo "PVE_SKILL_TARGETS=name,name or a skills directory picks targets by hand" >&2
	exit 1
fi

targets=()
for root in "${roots[@]}"; do
	targets+=("$root/$skill_name")
done

if [[ "${PVE_SKILL_LIST:-0}" == "1" ]]; then
	for i in "${!targets[@]}"; do
		echo "${targets[$i]} (${root_names[$i]})"
	done
	exit 0
fi

for tool in bun git; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		echo "$tool is required and was not found on PATH" >&2
		exit 1
	fi
done

cleanup() {
	if [[ -n "$staging" ]]; then
		rm -rf "$staging"
	fi
	if [[ -n "$previous" && -d "$previous" && ! -e "$target" ]]; then
		mv "$previous" "$target"
	fi
	if [[ -n "$work_dir" ]]; then
		rm -rf "$work_dir"
	fi
}
trap cleanup EXIT

if [[ -n "${PVE_SKILL_SOURCE_DIR:-}" ]]; then
	repo_dir="$(cd "$PVE_SKILL_SOURCE_DIR" && pwd -P)"
elif [[ -f "$PWD/SKILL.md" && -f "$PWD/install-pve-skill" && -d "$PWD/src" ]]; then
	repo_dir="$PWD"
else
	work_dir="$(mktemp -d)"
	repo_dir="$work_dir/repo"
	git clone --quiet --depth 1 --branch "$repo_ref" "$repo_url" "$repo_dir" </dev/null
fi

for entry in SKILL.md package.json bun.lock LICENSE README.md; do
	if [[ ! -f "$repo_dir/$entry" ]]; then
		echo "$entry not found in $repo_dir" >&2
		exit 1
	fi
done
for entry in src schema; do
	if [[ ! -d "$repo_dir/$entry" ]]; then
		echo "$entry/ not found in $repo_dir" >&2
		exit 1
	fi
done

need_env=0
for target in "${targets[@]}"; do
	if [[ ! -f "$target/pve.env" || "${PVE_SKILL_OVERWRITE_ENV:-0}" == "1" ]]; then
		need_env=1
	fi
done
target=""

tty_in=""
if { : </dev/tty; } 2>/dev/null; then
	tty_in=/dev/tty
fi

ask() {
	local name="$1" prompt="$2" secret="${3:-}"
	local value="${!name:-}"
	if [[ -z "$value" && -n "$tty_in" ]]; then
		if [[ -n "$secret" ]]; then
			read -r -s -p "$prompt: " value <"$tty_in" 2>"$tty_in"
			echo >"$tty_in"
		else
			read -r -p "$prompt: " value <"$tty_in" 2>"$tty_in"
		fi
	fi
	printf '%s' "$value"
}

env_line() {
	printf "export %s='%s'\n" "$1" "${2//\'/\'\\\'\'}"
}

env_body=""
if [[ "$need_env" -eq 1 ]]; then
	pve_host="$(ask PVE_HOST "PVE host")"
	if [[ -z "$pve_host" && -z "$tty_in" ]]; then
		echo "no terminal to ask on; set PVE_HOST and either PVE_USER with PVE_PASSWORD or PVE_TOKEN_ID with PVE_TOKEN_SECRET in the environment" >&2
		exit 2
	fi
	if [[ -z "$pve_host" ]]; then
		echo "PVE_HOST is required" >&2
		exit 2
	fi
	pve_port="$(ask PVE_PORT "PVE port (blank for 8006)")"
	pve_user="$(ask PVE_USER "PVE user, such as root@pam (blank for token only)")"
	pve_password=""
	if [[ -n "$pve_user" ]]; then
		pve_password="$(ask PVE_PASSWORD "PVE password for $pve_user" secret)"
	fi
	pve_token_id="$(ask PVE_TOKEN_ID "PVE token id, such as user@realm!name (blank for none)")"
	pve_token_secret=""
	if [[ -n "$pve_token_id" ]]; then
		pve_token_secret="$(ask PVE_TOKEN_SECRET "PVE token secret" secret)"
	fi
	pve_verify_ssl="$(ask PVE_VERIFY_SSL "Verify the TLS certificate, 1 or 0 (blank for 1)")"
	pve_node="$(ask PVE_NODE "Default node (blank for none)")"
	if [[ -z "$pve_password" && -z "$pve_token_secret" ]]; then
		echo "set PVE_USER with PVE_PASSWORD, or PVE_TOKEN_ID with PVE_TOKEN_SECRET" >&2
		exit 2
	fi
	env_body="$(
		env_line PVE_HOST "$pve_host"
		[[ -n "$pve_port" ]] && env_line PVE_PORT "$pve_port"
		[[ -n "$pve_user" ]] && env_line PVE_USER "$pve_user"
		[[ -n "$pve_password" ]] && env_line PVE_PASSWORD "$pve_password"
		[[ -n "$pve_token_id" ]] && env_line PVE_TOKEN_ID "$pve_token_id"
		[[ -n "$pve_token_secret" ]] && env_line PVE_TOKEN_SECRET "$pve_token_secret"
		[[ -n "$pve_verify_ssl" ]] && env_line PVE_VERIFY_SSL "$pve_verify_ssl"
		[[ -n "$pve_node" ]] && env_line PVE_NODE "$pve_node"
		true
	)"
fi

skill_text="$(<"$repo_dir/SKILL.md")"

first_modules=""
for target in "${targets[@]}"; do
	staging="$target.tmp.$$"
	rm -rf "$staging"
	mkdir -p "${target%/*}" "$staging"
	cp "$repo_dir/package.json" "$repo_dir/bun.lock" "$repo_dir/LICENSE" "$repo_dir/README.md" "$staging/"
	cp -R "$repo_dir/src" "$staging/src"
	cp -R "$repo_dir/schema" "$staging/schema"
	printf '%s\n' "${skill_text//<skill-dir>/$target}" > "$staging/SKILL.md"

	if [[ -n "$first_modules" ]]; then
		cp -R "$first_modules" "$staging/node_modules"
	else
		(cd "$staging" && bun install --production --frozen-lockfile >/dev/null </dev/null)
	fi

	if [[ -f "$target/pve.env" && "${PVE_SKILL_OVERWRITE_ENV:-0}" != "1" ]]; then
		cp -p "$target/pve.env" "$staging/pve.env"
	else
		(umask 077 && printf '%s\n' "$env_body" > "$staging/pve.env")
	fi
	chmod 600 "$staging/pve.env"

	previous=""
	if [[ -e "$target" ]]; then
		previous="$target.old.$$"
		rm -rf "$previous"
		mv "$target" "$previous"
	fi
	mv "$staging" "$target"
	staging=""
	if [[ -n "$previous" ]]; then
		rm -rf "$previous"
		previous=""
	fi
	first_modules="$target/node_modules"
done
target=""

echo "pve-agent skill installed in:"
for i in "${!targets[@]}"; do
	echo "  ${targets[$i]} (${root_names[$i]})"
done
